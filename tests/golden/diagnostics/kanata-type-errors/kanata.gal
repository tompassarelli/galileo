nix module
  arguments: config, lib, pkgs, ...
  let cfg = config.myConfig.modules.kanata
  let port = toString(cfg.port)
  let cfg = import(./other.nix)
  config when cfg.enable
    hardware.uinput.enable: true
    services.udev.extraRules: '''
      KERNEL=="uinput", MODE="0660", GROUP="uinput", OPTIONS+="static_node=uinput"

      '''
    users.groups.uinput: {}
    users.users.kanata
      isSystemUser: true
      group: "kanata"
      extraGroups: ["input", "uinput"]
    users.groups.kanata: {}
    myConfig.modules.kanata.enabel: true
    home-manager.users.tom: nix module(config, ...)
      home.sessionVariables.U: config.home.username
    services.kanata
      enable: config.services.kanata.enable
      package: pkgs.unstable.kanata
      keyboards when cfg.devices != []
        main
          devices: cfg.devics
          port: cfg.port when cfg.port > 1
          extraDefCfg: "process-unmapped-keys yes"
          extraArgs: cfg.extraArgs
          config: builtins.readFile(cfg.port)
    systemd.services.kanata-main.serviceConfig when cfg.devices != []
      DynamicUser: lib.mkForce(false)
      User: "kanata"
