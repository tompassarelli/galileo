type North, Room
north-main is a North

state entity MenuRow
  key: Text
state North lists ?row: MenuRow
state North is in Room
given Room is near North

event clear-menu-rows: North clears menu rows
on ?north clears menu rows
  then ?fresh is a new MenuRow {key: "x"}
  and every ?room where ?room is near ?north: ?north lists ?fresh
