type Item, Shop
given Shop sells Item for ?cost: Int
given Shop is closed
given Shop stocks ?items: nix Any
given Item is named ?name: Text
derived Shop offers Item
derived Shop totals ?n: Int

rule every-literal: ?shop offers ?item
  when ?shop sells ?item for ?cost
  and not ?shop is closed
  and ?cost <= 10
  and ?item is named ?name
  and contains(lowercase(?name), "tea")
  and ?double = ?cost * 2
  and ?shop stocks ?items
  and ?item in ?items
  and ?n = sum where ?shop sells ?i for ?_
  and ?total = sum ?c where ?shop sells ?i for ?c
  and ?low = min ?c where ?shop sells ?i for ?c and ?c > 0
  and ?high = max ?c where ?shop sells ?i for ?c
  and ?cheapest = min ?i by ?c where ?shop sells ?i for ?c
