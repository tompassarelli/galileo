type Command

given Command is number ?order: Int
  exactly one order per command
given Command walks ?node: Text then ?edge: Text
given Command runs ?executable: Text
  exactly one executable per command
given Command takes ?usage: Text
  exactly one usage per command
given Command defaults to ?argument: Text
  at most one argument per command
given Command defaults to no argument
given Command is summarized as ?summary: Text after ?gap: Text
given Command is common command ?order: Int as ?label: Text summarized as ?summary: Text after ?gap: Text
derived Command has a default leaf
derived Command needs leaf ?required: Bool
derived Command plans ?executable: Text with ?arguments: List Text

rule default-leaf: ?command has a default leaf
  when ?command defaults to ?argument

rule no-argument-leaf: ?command has a default leaf
  when ?command defaults to no argument

rule optional-leaf: ?command needs leaf false
  when ?command has a default leaf

rule required-leaf: ?command needs leaf true
  when ?command runs ?executable
  and not ?command has a default leaf

rule default-plan: ?command plans ?executable with [?node, ?edge, ?argument]
  when ?command walks ?node then ?edge
  and ?command runs ?executable
  and ?command defaults to ?argument

rule no-argument-plan: ?command plans ?executable with [?node, ?edge]
  when ?command walks ?node then ?edge
  and ?command runs ?executable
  and ?command defaults to no argument

rule required-plan: ?command plans ?executable with [?node, ?edge]
  when ?command walks ?node then ?edge
  and ?command runs ?executable
  and not ?command has a default leaf

flake-inputs
  is a Command
  is number 1
  walks "flake" then "inputs"
  runs "firn-views"
  takes "all"
  defaults to "all"
  is summarized as "List flake inputs: source, age, locked rev, follows, broken-path check." after "  "

flake-input-resolve
  is a Command
  is number 2
  walks "flake-input" then "resolve"
  runs "firn-flake-input"
  takes "emit"
  defaults to "emit"
  is summarized as "regenerate flake.nix by galileo build of flake.gal with the modules' flake-input facts" after "  "

host-prepare
  is a Command
  is number 3
  walks "host" then "prepare"
  runs "firn-rebuild"
  takes "<host>"
  defaults to no argument
  is summarized as "pin, validate, and realize one exact commit without activation" after "   "

host-activate
  is a Command
  is number 4
  walks "host" then "activate"
  runs "firn-rebuild"
  takes "<exact-store-path>"
  is summarized as "activate one already-realized exact NixOS toplevel without building" after "  "

host-rebuild
  is a Command
  is number 5
  walks "host" then "rebuild"
  runs "firn-rebuild"
  takes "<host>"
  defaults to no argument
  is summarized as "plan pins → build+validate commit snapshot → switch verified closure → tag generation" after "   "

host-rollback
  is a Command
  is number 6
  walks "host" then "rollback"
  runs "firn-rebuild"
  takes "<generation>"
  is summarized as "activate one exact prior NixOS system-profile generation" after "  "

host-impact
  is a Command
  is number 7
  walks "host" then "impact"
  runs "firn-rebuild"
  takes "[<host>]"
  defaults to no argument
  is summarized as "dry-run impact prediction (what will rebuild, estimated time)" after "  "

host-list
  is a Command
  is number 8
  walks "host" then "list"
  runs "firn-inventory"
  takes "all"
  defaults to "all"
  is summarized as "list every host directory under hosts/" after "         "

host-status
  is a Command
  is number 9
  walks "host" then "status"
  runs "firn-inventory"
  takes "<host>"
  defaults to no argument
  is summarized as "modules a host's configuration.gal turns on (galileo query)" after "    "

host-gen
  is a Command
  is number 10
  walks "host" then "gen"
  runs "firn-views"
  takes "<host>"
  defaults to no argument
  is summarized as "current and next NixOS generation numbers" after "       "

host-deploy
  is a Command
  is number 11
  walks "host" then "deploy"
  runs "firn-host-deploy"
  takes "<host>"
  is summarized as "start a remote host's self-upgrade from origin/main and print its revision" after "    "

module-list
  is a Command
  is number 12
  walks "module" then "list"
  runs "firn-inventory"
  takes "all|used|unused"
  defaults to "all"
  is summarized as "list modules (all, used = enabled somewhere, unused = orphan)" after "  "

module-refs
  is a Command
  is number 13
  walks "module" then "refs"
  runs "firn-inventory"
  takes "<name>"
  is summarized as "show which hosts reference a module (direct + via tags)" after "           "

module-status
  is a Command
  is number 14
  walks "module" then "status"
  runs "firn-inventory"
  takes "all"
  defaults to "all"
  is summarized as "list modules the default host's configuration.gal turns on" after "            "

module-add
  is a Command
  is number 15
  walks "module" then "add"
  runs "firn-authoring"
  takes "<name>"
  is summarized as "scaffold modules/<name>/default.gal, galileo check, build and git add it" after "            "

module-enable
  is a Command
  is number 16
  walks "module" then "enable"
  runs "firn-tag"
  takes "<name>"
  is summarized as "remove <name> from :disabled (no module-level force-on)" after "         "

module-disable
  is a Command
  is number 17
  walks "module" then "disable"
  runs "firn-tag"
  takes "<name>"
  is summarized as "add '<host> disables <name>' to the host's _generated-enables.gal" after "        "

platform-list
  is a Command
  is number 18
  walks "platform" then "list"
  runs "firn-views"
  takes "all|darwin|linux"
  defaults to "all"
  is summarized as "platform compat overview (all = full matrix; others = filtered)" after "  "

platform-show
  is a Command
  is number 19
  walks "platform" then "show"
  runs "firn-views"
  takes "<name>"
  is summarized as "compat report for one module" after "            "

platform-safelist
  is a Command
  is number 20
  walks "platform" then "safelist"
  runs "firn-views"
  takes "all"
  defaults to "all"
  is summarized as "print the 'supports darwin' fact for config/tags.gal" after "           "

repo-watch
  is a Command
  is number 21
  walks "repo" then "watch"
  runs "firn-repo-workflow"
  takes "all"
  defaults to "all"
  is summarized as "re-run validator on .rkt save (no external deps)" after "                "

repo-diff
  is a Command
  is number 22
  walks "repo" then "diff"
  runs "firn-repo-build"
  takes "<target>|all"
  defaults to "all"
  is summarized as "galileo build --check: compare .gal output against existing .nix" after "        "

repo-doctor
  is a Command
  is number 23
  walks "repo" then "doctor"
  runs "firn-repo-workflow"
  takes "all"
  defaults to "all"
  is summarized as "repo health check (untracked, stale, schema, orphans, validator)" after "               "

repo-pin-ancestry
  is a Command
  is number 24
  walks "repo" then "pin-ancestry"
  runs "firn-repo-workflow"
  takes "all"
  defaults to "all"
  is summarized as "check first-party input pins against local main ancestry" after "         "

repo-upgrade
  is a Command
  is number 25
  walks "repo" then "upgrade"
  runs "firn-repo-workflow"
  takes "now|dry-run"
  defaults to "now"
  is summarized as "flake update + schema diff + validate (use dry-run leaf to preview)" after "      "

repo-build
  is a Command
  is number 26
  walks "repo" then "build"
  runs "firn-repo-build"
  takes "[all]"
  defaults to "all"
  is summarized as "resolve tags and flake inputs, then galileo build every .gal into .nix" after "              "

repo-validate
  is a Command
  is number 27
  walks "repo" then "validate"
  runs "firn-schema"
  takes "[all]"
  defaults to "all"
  is summarized as "lint .nix syntax + validate option paths, types, packages" after "           "

repo-lint
  is a Command
  is number 28
  walks "repo" then "lint"
  runs "firn-repo-workflow"
  takes "[all]"
  defaults to "all"
  is summarized as "syntax-check generated .nix files" after "               "

repo-architecture
  is a Command
  is number 29
  walks "repo" then "architecture"
  runs "firn-repo-workflow"
  takes "all|bundle"
  defaults to "all"
  is summarized as "render the tracked agent-configuration map; bundle prints the full read" after "  "

schema-explain
  is a Command
  is number 30
  walks "schema" then "explain"
  runs "firn-views"
  takes "<path>"
  is summarized as "show schema entry + repo references for an option" after "    "

schema-extract
  is a Command
  is number 31
  walks "schema" then "extract"
  runs "firn-schema"
  takes "[<host>]"
  defaults to no argument
  is summarized as "regenerate options schema cache from nix eval" after "  "

