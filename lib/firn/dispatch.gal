repo-build is common command 1 as "build" summarized as "regenerate .nix from .bnix" after "       "
repo-validate is common command 2 as "validate" summarized as "lint + type/package/path check" after "    "
host-impact is common command 3 as "impact" summarized as "what will rebuild, estimated time" after "      "
repo-doctor is common command 4 as "doctor" summarized as "repo health check" after "      "
tag-status is common command 5 as "status" summarized as "enabled-tags.bnix + resolved active modules" after "       "
tag-enable is common command 6 as "enable <t>" summarized as "add a tag to the current host" after "   "
tag-opt-in is common command 7 as "opt-in <t>+<m>" summarized as "add +<module> under tag <t>" after "   "
module-disable is common command 8 as "disable <m>" summarized as "add <m> to :disabled (hard off)" after "   "
repo-diff is common command 9 as "diff" summarized as "re-emit and diff vs existing .nix" after "        "
