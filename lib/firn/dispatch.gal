  is a Command
  is number 32
  walks "secret" then "list"
  runs "firn-authoring"
  takes "all"
  defaults to "all"
  is summarized as "list secret names under secrets/" after "     "

secret-show
  is a Command
  is number 33
  walks "secret" then "show"
  runs "firn-authoring"
  takes "<name>"
  is summarized as "decrypt and print a secret to stdout" after "  "

secret-edit
  is a Command
  is number 34
  walks "secret" then "edit"
  runs "firn-authoring"
  takes "<name>"
  is summarized as "open an existing secret in $EDITOR via sops" after "  "

tag-list
  is a Command
  is number 35
  walks "tag" then "list"
  runs "firn-tag"
  takes "all"
  defaults to "all"
  is summarized as "tag universe (sourced from modules' :tags / :tags-opt-in)" after "                    "

tag-show
  is a Command
  is number 36
  walks "tag" then "show"
  runs "firn-tag"
  takes "<module>"
  is summarized as "show a module's :tags and :tags-opt-in" after "               "

tag-filter
  is a Command
  is number 37
  walks "tag" then "filter"
  runs "firn-tag"
  takes "<tag>"
  is summarized as "list modules carrying a tag" after "                "

tag-index
  is a Command
  is number 38
  walks "tag" then "index"
  runs "firn-tag"
  takes "repo|stdout"
  defaults to "repo"
  is summarized as "write .beagle-cache/tags.jsonl (or 'stdout' to pipe)" after "           "

tag-resolve
  is a Command
  is number 39
  walks "tag" then "resolve"
  runs "firn-tag"
  takes "<host>|all [+emit]"
  defaults to no argument
  is summarized as "resolve tag facts → active module set; +emit regenerates _generated-enables.nix by galileo build" after "  "

tag-enable
  is a Command
  is number 40
  walks "tag" then "enable"
  runs "firn-tag"
  takes "<tag>"
  is summarized as "add '<host> enables <tag>' to the current host's _generated-enables.gal" after "                "

tag-disable
  is a Command
  is number 41
  walks "tag" then "disable"
  runs "firn-tag"
  takes "<tag>"
  is summarized as "remove a tag's enables, adds and drops facts from the current host's _generated-enables.gal" after "               "

tag-opt-in
  is a Command
  is number 42
  walks "tag" then "opt-in"
  runs "firn-tag"
  takes "<tag>+<module>"
  is summarized as "add '<host> adds <module> to <tag>' to _generated-enables.gal, enabling <tag>" after "       "

tag-opt-out
  is a Command
  is number 43
  walks "tag" then "opt-out"
  runs "firn-tag"
  takes "<tag>+<module>"
  is summarized as "add '<host> drops <module> from <tag>' to _generated-enables.gal, enabling <tag>" after "      "

tag-status
  is a Command
  is number 44
  walks "tag" then "status"
  runs "firn-tag"
  takes "<host>"
  defaults to no argument
  is summarized as "show the host's tag facts in _generated-enables.gal + resolved active modules" after "               "

template-service
  is a Command
  is number 45
  walks "template" then "service"
  runs "firn-authoring"
  takes "<name>"
  is summarized as "scaffold a NixOS service-wrapping module from schema" after "    "

template-submodule
  is a Command
  is number 46
  walks "template" then "submodule"
  runs "firn-authoring"
  takes "<name>"
  is summarized as "scaffold a module with an option-attrs submodule shape" after "  "

template-home
  is a Command
  is number 47
  walks "template" then "home"
  runs "firn-authoring"
  takes "<name>"
  is summarized as "scaffold a home-manager-only module" after "       "

template-host
  is a Command
  is number 48
  walks "template" then "host"
  runs "firn-authoring"
  takes "<name>"
  is summarized as "scaffold a new host's configuration.gal and enabled-tags.gal, then galileo build" after "       "

?command is common command ?order as ?label summarized as ?summary after ?gap
  repo-build      1  "build"           "regenerate .nix from .gal (galileo build)"    "       "
  repo-validate   2  "validate"        "lint + type/package/path check"               "    "
  host-impact     3  "impact"          "what will rebuild, estimated time"            "      "
  repo-doctor     4  "doctor"          "repo health check"                            "      "
  tag-status      5  "status"          "tag facts + resolved active modules"          "       "
  tag-enable      6  "enable <t>"      "add a tag to the current host"                "   "
  tag-opt-in      7  "opt-in <t>+<m>"  "add +<module> under tag <t>"                  "   "
  module-disable  8  "disable <m>"     "add <m> to :disabled (hard off)"              "   "
  repo-diff       9  "diff"            "re-emit and diff vs existing .nix"            "        "
