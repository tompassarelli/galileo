type Command

given {command: Command} is number {order: Int}
  exactly one order per command
given {command: Command} walks {node: Text} then {edge: Text}
given {command: Command} runs {executable: Text}
  exactly one executable per command
given {command: Command} takes {usage: Text}
  exactly one usage per command
given {command: Command} defaults to {argument: Text}
  at most one argument per command
given {command: Command} defaults to no argument
given {command: Command} is summarized as {summary: Text} after {gap: Text}
given {command: Command} is common command {order: Int} as {label: Text} summarized as {summary: Text} after {gap: Text}
derived {command: Command} has a default leaf
derived {command: Command} needs leaf {required: Bool}
derived {command: Command} plans {executable: Text} with {arguments: List Text}

rule default-leaf: ?command has a default leaf
  when ?command defaults to ?argument

rule no-argument-leaf: ?command has a default leaf
  when ?command defaults to no argument

rule optional-leaf: ?command needs leaf false
  when ?command has a default leaf

rule required-leaf: ?command needs leaf true
  when ?command runs ?executable
  and not ?command has a default leaf

rule default-plan: ?command plans ?executable with ?arguments
  when ?command walks ?node then ?edge
  and ?command runs ?executable
  and ?command defaults to ?argument
  and ?arguments = [?node, ?edge, ?argument]

rule no-argument-plan: ?command plans ?executable with ?arguments
  when ?command walks ?node then ?edge
  and ?command runs ?executable
  and ?command defaults to no argument
  and ?arguments = [?node, ?edge]

rule required-plan: ?command plans ?executable with ?arguments
  when ?command walks ?node then ?edge
  and ?command runs ?executable
  and not ?command has a default leaf
  and ?arguments = [?node, ?edge]

flake-inputs is a Command
flake-inputs is number 1
flake-inputs walks "flake" then "inputs"
flake-inputs runs "firn-views"
flake-inputs takes "all"
flake-inputs defaults to "all"
flake-inputs is summarized as "List flake inputs: source, age, locked rev, follows, broken-path check." after "  "

