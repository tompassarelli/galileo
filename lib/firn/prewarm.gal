type Prewarm

given Prewarm targets ?platform: Text with prefix ?prefix: Text suffix ?suffix: Text
given Prewarm chooses lease ?action: Text for identity ?identity: Bool same key ?same: Bool
given Prewarm writes stamp for success ?success: Bool cancelled ?cancelled: Bool bounded ?bounded: Bool
given Prewarm launches hook for committed ?committed: Bool updated main ?updated: Bool
given Prewarm recognizes rebuild ?node: Text then ?edge: Text

prewarm
  is a Prewarm
  targets ?platform with prefix ?prefix suffix ?suffix
    "linux"   "nixosConfigurations."   ".config.system.build.toplevel"
    "darwin"  "darwinConfigurations."  ".system"
  chooses lease ?action for identity ?identity same key ?same
    "contended"     false  false
    "contended"     false  true
    "supersede"     true   false
    "deduplicated"  true   true
  writes stamp for success true cancelled false bounded true
  launches hook for committed true updated main true
  recognizes rebuild ?node then ?edge
    "rebuild"  ""
    "host"     "rebuild"
